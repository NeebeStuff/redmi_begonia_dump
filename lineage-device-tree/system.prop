# Audio
audio.safemedia.bypass=true
ro.audio.silent=0

# Bluetooth
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true
bluetooth.profile.sap.server.enabled=true

# Display
debug.sf.disable_backpressure=0
debug.sf.enable_gl_backpressure=1
debug.sf.enable_layer_caching=0
debug.sf.hw=1
debug.sf.latch_unsignaled=1
debug.sf.luma_sampling=0
ro.surface_flinger.protected_contents=0
ro.surface_flinger.set_idle_timer_ms=100
ro.surface_flinger.set_touch_timer_ms=10
ro.surface_flinger.use_content_detection_for_refresh_rate=0

# DRM
drm.service.enabled=true

# Health
ro.charger.disable_init_blank=1
ro.charger.enable_suspend=1

# Media
media.mediadrmservice.enable=true
media.recorder.show_manufacturer_and_model=true

# Radio
persist.radio.VT_ENABLE=1
persist.radio.calls.on.ims=1
persist.radio.data_con_rprt=1
persist.radio.data_ltd_sys_ind=1
persist.radio.rat_on=combine
persist.radio.volte.dan_support=true

# Wi-Fi
ro.wifi.channels=
wifi.direct.interface=p2p0
wifi.interface=wlan0
wifi.tethering.interface=ap0

